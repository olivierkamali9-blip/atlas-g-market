{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next",
      "config": { "installCommand": "npm install" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/frontend/src/App.tsx",
      "headers": { "Content-Type": "text/html; charset=utf-8" }
    }
  ]
}