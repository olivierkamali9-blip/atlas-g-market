{
  "name": "atlas-g-market-backend",
  "version": "1.0.0",
  "description": "API REST Backend pour l'application Atlas G-market - Plateforme globale de mise en relation de l'offre et de la demande",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "marketplace",
    "express",
    "typescript",
    "annonces",
    "search",
    "messaging"
  ],
  "author": "G-Tech HQ",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.3"
  }
}